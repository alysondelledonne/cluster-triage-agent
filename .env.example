# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Which provider the CLI and evals use by default: anthropic | openai | grok | fake
PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# xAI (Grok), via its OpenAI-compatible API
# A "Grok Interface" key from console.x.ai (API Keys), not a key from grok.com,
# with prepaid credits on the same team. Keys start with grok_.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# The comparison model (DECISIONS.md 034)
XAI_MODEL=grok-4.20-0309-non-reasoning

# Agent limits
# Tool calls per triage run before the forced submission turn
MAX_TOOL_CALLS=12
# Room for a diagnosis with a YAML fix; too low and the reply is cut off mid tool call
MAX_OUTPUT_TOKENS=2048

# Where each agent run is logged as one JSON line
RUN_LOG=runs/runs.jsonl

# Tracing (optional): set to 1 after `uv sync --extra tracing` and starting Phoenix
TRACING=0
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
