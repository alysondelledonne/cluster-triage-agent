# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Which provider the CLI and evals use by default: anthropic | openai | grok | fake
PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# xAI (Grok), via its OpenAI-compatible API
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Set to the current Grok model ID shown in your xAI console
XAI_MODEL=

# Agent limits
MAX_STEPS=8
MAX_OUTPUT_TOKENS=1024

# Where each agent run is logged as one JSON line
RUN_LOG=runs/runs.jsonl

# Tracing (optional): set to 1 after `uv sync --extra tracing` and starting Phoenix
TRACING=0
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
